# Coraza WAF Configuration for SIAKAD Local Development
# Installation: sudo tee /etc/caddy/coraza-rules.conf > /dev/null
# Note: Requires Caddy built with Coraza module

# ============================================================
# Coraza WAF Engine Configuration
# ============================================================

SecRuleEngine On
SecDefaultAction "phase:1,log,auditlog,deny,status:403"
SecDefaultAction "phase:2,log,auditlog,deny,status:403"

# ============================================================
# SIAKAD Application Specific Whitelist Rules
# ============================================================

# Allow health check endpoint
SecRule REQUEST_URI "@beginsWith /index.php?page=health" \
    "id:1000,phase:2,pass,nolog"

# Allow static assets (CSS, JS, images, fonts)
SecRule REQUEST_FILENAME "@rx \.(css|js|jpg|jpeg|png|gif|ico|woff|woff2|ttf|svg|webp)$" \
    "id:1001,phase:2,pass,nolog"

# Allow uploads directory
SecRule REQUEST_URI "@beginsWith /uploads/" \
    "id:1002,phase:2,pass,nolog"

# Allow assets directory
SecRule REQUEST_URI "@beginsWith /assets/" \
    "id:1003,phase:2,pass,nolog"

# ============================================================
# SQL Injection Prevention
# ============================================================

# Block SQL keywords in GET/POST parameters
SecRule ARGS "@rx (?i:union.*select|select.*from|insert.*into|update.*set|delete.*from|drop.*table|create.*table|alter.*table)" \
    "id:2000,phase:2,deny,log,msg:'SQL Injection Attempt Blocked',tag:'SQLI',tag:'OWASP_CRS/INJECTION'"

# Block SQL comments
SecRule ARGS "@rx (?:--|#|/\*|\*/)" \
    "id:2001,phase:2,deny,log,msg:'SQL Comment Detected',tag:'SQLI'"

# Block SQL functions
SecRule ARGS "@rx (?i:xp_|sp_|exec|execute|script|javascript)" \
    "id:2002,phase:2,deny,log,msg:'Dangerous SQL Function',tag:'SQLI'"

# ============================================================
# Cross-Site Scripting (XSS) Prevention
# ============================================================

# Block script tags
SecRule ARGS "@rx (?i:<script[^>]*>)" \
    "id:3000,phase:2,deny,log,msg:'Script Tag Detected',tag:'XSS',tag:'OWASP_CRS/XSS'"

# Block event handlers
SecRule ARGS "@rx (?i:on(?:load|error|click|submit|mouse|focus|blur|change))" \
    "id:3001,phase:2,deny,log,msg:'Event Handler Detected',tag:'XSS'"

# Block javascript: protocol
SecRule ARGS "@rx (?i:javascript:)" \
    "id:3002,phase:2,deny,log,msg:'JavaScript Protocol Detected',tag:'XSS'"

# Block iframe tags
SecRule ARGS "@rx (?i:<iframe[^>]*>)" \
    "id:3003,phase:2,deny,log,msg:'IFrame Tag Detected',tag:'XSS'"

# Block embed/object tags
SecRule ARGS "@rx (?i:<(?:embed|object|applet)[^>]*>)" \
    "id:3004,phase:2,deny,log,msg:'Embed/Object Tag Detected',tag:'XSS'"

# ============================================================
# Path Traversal / Local File Inclusion (LFI)
# ============================================================

# Block directory traversal patterns
SecRule ARGS "@rx (?:\.\./|\.\.\\)" \
    "id:4000,phase:2,deny,log,msg:'Path Traversal Attempt',tag:'LFI',tag:'OWASP_CRS/LFI'"

# Block access to sensitive files
SecRule REQUEST_FILENAME "@rx (?:/proc/|/etc/|/dev/|/sys/|/var/log)" \
    "id:4001,phase:2,deny,log,msg:'Sensitive File Access Attempt',tag:'LFI'"

# Block null byte injection
SecRule ARGS "@rx %00" \
    "id:4002,phase:2,deny,log,msg:'Null Byte Injection',tag:'LFI'"

# ============================================================
# File Upload Protection
# ============================================================

# Only allow image uploads in landing_images handler
SecRule REQUEST_URI "@contains landing_images" \
    "chain,id:5000,phase:2,log,msg:'File Upload Validation for landing_images'"
SecRule FILES_TMPNAMES "@rx \.(?!jpg|jpeg|png|gif|webp).*$" \
    "deny,status:403,msg:'Invalid File Type - Only JPG, PNG, GIF, WebP Allowed',tag:'FILE_UPLOAD'"

# Check file size (2MB limit)
SecRule FILES_SIZE "@gt 2097152" \
    "id:5001,phase:2,deny,log,msg:'File Upload Size Exceeded (Max 2MB)',tag:'FILE_UPLOAD'"

# Block executable files
SecRule FILES_TMPNAMES "@rx \.(?:php|php3|php4|php5|phtml|exe|bat|cmd|com|sh)$" \
    "id:5002,phase:2,deny,status:403,msg:'Executable File Upload Blocked',tag:'FILE_UPLOAD'"

# ============================================================
# CSRF Protection
# ============================================================

# Verify CSRF token for POST requests to sensitive pages
SecRule REQUEST_METHOD "@eq POST" \
    "chain,id:6000,phase:2,log,msg:'CSRF Token Validation'"
SecRule REQUEST_URI "@contains landing_images" \
    "chain"
SecRule ARGS:csrf "!@rx ^[a-f0-9]{32}$" \
    "deny,status:403,msg:'Invalid or Missing CSRF Token',tag:'CSRF'"

# ============================================================
# HTTP Response Splitting / Header Injection
# ============================================================

# Block carriage return and line feed in parameters
SecRule ARGS "@rx (?:\r|\n)" \
    "id:7000,phase:2,deny,log,msg:'HTTP Response Splitting Attempt',tag:'RESPONSE_SPLITTING'"

# ============================================================
# Protocol Attack Prevention
# ============================================================

# Only allow standard HTTP methods
SecRule REQUEST_METHOD "!@rx ^(?:GET|POST|HEAD|OPTIONS|PUT|DELETE|PATCH)$" \
    "id:8000,phase:2,deny,log,msg:'Unusual HTTP Method',tag:'PROTOCOL_VIOLATION'"

# Block requests with multiple content-type headers
SecRule REQUEST_HEADERS:Content-Type "@rx .+,.+" \
    "id:8001,phase:2,deny,log,msg:'Multiple Content-Type Headers',tag:'PROTOCOL_VIOLATION'"

# ============================================================
# Content Type Validation
# ============================================================

# Validate POST requests have proper content-type
SecRule REQUEST_METHOD "@eq POST" \
    "chain,id:9000,phase:1,log,msg:'Content-Type Validation'"
SecRule REQUEST_HEADERS:Content-Type "!@rx (?:application/x-www-form-urlencoded|multipart/form-data|application/json)" \
    "deny,status:415,msg:'Unsupported Content-Type',tag:'CONTENT_TYPE'"

# ============================================================
# XML/XXE Prevention
# ============================================================

# Block XML declarations
SecRule ARGS "@rx <\?xml" \
    "id:10000,phase:2,deny,log,msg:'XML Declaration Detected',tag:'XXE'"

# Block DOCTYPE declarations
SecRule ARGS "@rx <!DOCTYPE" \
    "id:10001,phase:2,deny,log,msg:'DOCTYPE Declaration Blocked',tag:'XXE'"

# Block ENTITY declarations
SecRule ARGS "@rx <!ENTITY" \
    "id:10002,phase:2,deny,log,msg:'ENTITY Declaration Blocked',tag:'XXE'"

# ============================================================
# Admin Panel Protection
# ============================================================

# Allow dashboard access
SecRule REQUEST_URI "@beginsWith /index.php?page=dashboard" \
    "id:11000,phase:2,pass,nolog"

# Allow admin pages
SecRule REQUEST_URI "@beginsWith /index.php?page=prodi" \
    "id:11001,phase:2,pass,nolog"

SecRule REQUEST_URI "@beginsWith /index.php?page=mahasiswa" \
    "id:11002,phase:2,pass,nolog"

SecRule REQUEST_URI "@beginsWith /index.php?page=dosen" \
    "id:11003,phase:2,pass,nolog"

SecRule REQUEST_URI "@beginsWith /index.php?page=landing_images" \
    "id:11004,phase:2,pass,nolog"

SecRule REQUEST_URI "@beginsWith /index.php?page=kelas" \
    "id:11005,phase:2,pass,nolog"

SecRule REQUEST_URI "@beginsWith /index.php?page=nilai" \
    "id:11006,phase:2,pass,nolog"

SecRule REQUEST_URI "@beginsWith /index.php?page=presensi" \
    "id:11007,phase:2,pass,nolog"

# ============================================================
# Rate Limiting Rules
# ============================================================

# Limit login attempts (10 per minute per IP)
SecRule REQUEST_URI "@contains page=login" \
    "chain,id:12000,phase:5,log,msg:'Login Rate Limit Check',tag:'RATE_LIMIT'"
SecAction "setvar:ip.login_count=+1,expirevar:ip.login_count=60"
SecRule ip.login_count "@gt 10" \
    "deny,status:429,msg:'Too Many Login Attempts - Rate Limited',tag:'RATE_LIMIT'"

# ============================================================
# Anomaly Scoring / Detection
# ============================================================

# Track suspicious patterns
SecRule ARGS "@rx (?:alert|confirm|eval|expression)" \
    "id:13000,phase:2,log,msg:'Suspicious JavaScript Function Detected',tag:'ANOMALY',tag:'OWASP_CRS/INJECTION'"

# ============================================================
# Logging Configuration
# ============================================================

SecAuditEngine On
SecAuditLogType Concurrent
SecAuditLog /var/log/caddy/coraza-audit.log
SecDebugLog /var/log/caddy/coraza-debug.log
SecDebugLogLevel 3

# Request body inspection
SecRequestBodyAccess On
SecRequestBodyLimit 131072
SecRequestBodyNoFilesLimit 8192
SecRequestBodyLimitAction ProcessPartial

# Response body inspection
SecResponseBodyAccess On
SecResponseBodyLimit 524288
SecResponseBodyLimitAction ProcessPartial

# ============================================================
# Variable Settings
# ============================================================

# Disable collection (if needed for performance)
# SecCollectionTimeout 600

# Set paranoia level (1=low, 2=medium, 3=high)
SecMarker "PARANOIA_LEVEL_1"
